{
  "name": "pot-royale",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite client",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test server/test/*.test.ts",
    "loadtest": "tsx server/scripts/loadtest.ts"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "tsx": "^4.20.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
